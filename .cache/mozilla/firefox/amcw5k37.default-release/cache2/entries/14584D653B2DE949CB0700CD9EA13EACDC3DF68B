/* ================================
   TOOLTIP BOX
================================ */
.cta-tooltip {
  position: absolute;
  background: #ffffff;
  padding: 15px 18px;
  border-radius: 6px;
  max-width: 300px;
  font-size: 14px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
